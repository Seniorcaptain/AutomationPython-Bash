## 🔎 Lab 02 — Subdomain Enumeration & Live Checker

**`subdomain_enum.py`** &nbsp;|&nbsp; `Python 3` &nbsp;|&nbsp; Recon / OSINT

> Automated recon pipeline wrapping `subfinder` + `httpx` to enumerate subdomains and probe live hosts — structured for bug bounty, external attack surface mapping, and red team pre-engagement recon.

### What It Does

```
Target Domain
     │
     ▼
┌─────────────┐     ┌───────────────────────┐
│  subfinder  │────▶│  <domain>.txt         │  All discovered subdomains
└─────────────┘     └───────────────────────┘
                                │
                                ▼
                    ┌─────────────────────────┐     ┌───────────────────────────┐
                    │        httpx            │────▶│  <domain>_live.txt        │  Live hosts + status codes
                    └─────────────────────────┘     └───────────────────────────┘
```

### Script

```python
#!/usr/bin/env python3
"""
Subdomain Enumeration and Live Checker
Uses subfinder and httpx to discover live subdomains for a given domain.

Dependencies:
  - subfinder  → https://github.com/projectdiscovery/subfinder
  - httpx      → https://github.com/projectdiscovery/httpx
  - Python 3.7+

Usage:
  python3 subdomain_enum.py example.com
  python3 subdomain_enum.py example.com --all all_subs.txt --live live_subs.txt
"""
import subprocess, sys, argparse, os, shutil
from datetime import datetime

def print_progress(message):
    timestamp = datetime.now().strftime("%H:%M:%S")
    print(f"[{timestamp}] {message}")

def check_tool(tool_name):
    if shutil.which(tool_name) is None:
        print_progress(f"ERROR: {tool_name} not found. Install it first.")
        return False
    return True

def run_subfinder(domain, output_file):
    print_progress(f"Starting subfinder for: {domain}")
    try:
        result = subprocess.run(
            ["subfinder", "-d", domain, "-silent", "-o", output_file],
            capture_output=True, text=True, timeout=300
        )
        if result.returncode != 0:
            print_progress(f"subfinder error: {result.stderr}")
            return False
        if os.path.exists(output_file) and os.path.getsize(output_file) > 0:
            with open(output_file) as f:
                count = sum(1 for _ in f)
            print_progress(f"Found {count} unique subdomains.")
            return True
        print_progress("No subdomains discovered.")
        return False
    except subprocess.TimeoutExpired:
        print_progress("subfinder timed out (300s).")
        return False

def run_httpx(input_file, output_file):
    print_progress("Probing live subdomains with httpx...")
    try:
        result = subprocess.run(
            ["httpx", "-l", input_file, "-silent", "-o", output_file,
             "-status-code", "-threads", "50"],
            capture_output=True, text=True, timeout=300
        )
        if os.path.exists(output_file) and os.path.getsize(output_file) > 0:
            with open(output_file) as f:
                live_count = sum(1 for _ in f)
            print_progress(f"Live subdomains found: {live_count}")
            return True
        print_progress("No live subdomains detected.")
        return False
    except subprocess.TimeoutExpired:
        print_progress("httpx timed out (300s).")
        return False

def main():
    parser = argparse.ArgumentParser(description="Enumerate live subdomains.")
    parser.add_argument("domain", help="Target domain (e.g., example.com)")
    parser.add_argument("--all",  help="Output file for all subdomains")
    parser.add_argument("--live", help="Output file for live subdomains")
    args = parser.parse_args()

    all_output  = args.all  or f"{args.domain}.txt"
    live_output = args.live or f"{args.domain}_live.txt"

    print_progress("=== Subdomain Enumeration Tool ===")
    print_progress(f"Target: {args.domain}")

    if not check_tool("subfinder") or not check_tool("httpx"):
        sys.exit(1)

    if not run_subfinder(args.domain, all_output):
        sys.exit(1)

    if os.path.getsize(all_output) == 0:
        print_progress("No subdomains to probe. Exiting.")
        sys.exit(0)

    run_httpx(all_output, live_output)

    print_progress("=== Summary ===")
    with open(all_output) as f:
        print_progress(f"Total subdomains : {sum(1 for _ in f)}")
    if os.path.exists(live_output):
        with open(live_output) as f:
            print_progress(f"Live subdomains  : {sum(1 for _ in f)}")
    print_progress("Done.")

if __name__ == "__main__":
    main()
```

### Usage

```bash
# Basic run
python3 subdomain_enum.py example.com

# Custom output paths
python3 subdomain_enum.py example.com --all all.txt --live live.txt

# Install dependencies (Go required)
go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest
```

